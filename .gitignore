# Dependencies
node_modules/
package-lock.json.bak

# SQLite Databases & Backups (Preserve data privacy)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
data/*_backup*.db

# Keep the data directory tracked for automatic database initialization
!data/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime and temporary data
pids
*.pid
*.seed
*.pid.lock

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db

# IDE & Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
